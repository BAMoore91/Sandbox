# ============================================================================
#  OpenPBX — environment configuration
#  Copy to .env and fill in real values. NEVER commit your .env file.
# ============================================================================

# ---- General -------------------------------------------------------------
# Public hostname/IP clients and Twilio will reach this server on.
# Must be a publicly resolvable FQDN if you want TLS/WSS to work.
PUBLIC_HOSTNAME=pbx.example.com
# Public IP of this host (used in PJSIP external_media_address / NAT).
PUBLIC_IP=203.0.113.10
# Private/Docker network the media engine binds to (usually leave as-is).
LOCAL_NET=172.20.0.0/16

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=openpbx
POSTGRES_USER=openpbx
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Asterisk ARI / AMI --------------------------------------------------
# ARI is used by the management API for live call control & origination.
ARI_USERNAME=openpbx-ari
ARI_PASSWORD=change-me-ari-secret
# AMI is used for realtime events (registrations, CDR, queue stats).
AMI_USERNAME=openpbx-ami
AMI_PASSWORD=change-me-ami-secret

# ---- Management API ------------------------------------------------------
# 32+ char random string for signing JWTs.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First super-admin bootstrapped on startup if no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
ACCESS_TOKEN_TTL_MINUTES=720

# ---- RTP media port range (must match firewall / Twilio docs) ------------
RTP_START=10000
RTP_END=10200

# ---- SIP / WebRTC transports --------------------------------------------
SIP_UDP_PORT=5060
SIP_TCP_PORT=5060
SIP_TLS_PORT=5061
WSS_PORT=8089

# ---- TLS certificates (mount real certs in production) -------------------
# Paths INSIDE the asterisk container. The entrypoint generates a
# self-signed pair here on first boot if none are present.
TLS_CERT_FILE=/etc/asterisk/keys/fullchain.pem
TLS_KEY_FILE=/etc/asterisk/keys/privkey.pem

# ---- Data retention sweeper ----------------------------------------------
# In-process scheduler that purges recordings/CDR past each tenant's window
# (configured per-company in the portal; 0 = keep forever). Set
# RETENTION_ENABLED=false to disable it and instead drive purges from an
# external cron hitting POST /api/tenants/{id}/retention/run.
RETENTION_ENABLED=true
RETENTION_INTERVAL_HOURS=24

# ---- Notifications (missed-call / voicemail email + SMS) -----------------
# A background worker drains the outbox and delivers via SMTP and/or Twilio
# SMS. Leave SMTP_HOST or the Twilio vars empty to skip that channel.
NOTIFICATIONS_ENABLED=true
NOTIFY_POLL_SECONDS=15
NOTIFY_MAX_ATTEMPTS=5
# When this many+ due alerts target the same channel+recipient in one drain,
# they're coalesced into a single digest message (rate-limits bursts).
NOTIFY_DIGEST_THRESHOLD=3
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=OpenPBX <noreply@example.com>
# SMS (Twilio REST). TWILIO_SMS_FROM may be an E.164 number or a Messaging
# Service SID (MG…). Reuses your Twilio account; separate from SIP trunking.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Public base URL used to build portal links inside notifications.
PUBLIC_BASE_URL=https://pbx.example.com

# ---- Stripe billing (optional) -------------------------------------------
# Leave STRIPE_SECRET_KEY empty to disable charging (invoices still finalize
# and stay 'open'). Webhook secret verifies Stripe callbacks to /api/billing/
# webhook. The monthly auto-finalize scheduler snapshots last month's invoices
# for all active tenants on BILLING_RUN_DAY and charges those with auto-bill on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_AUTOFINALIZE_ENABLED=true
BILLING_RUN_DAY=1
BILLING_CHECK_HOURS=6

# ---- Auto phone provisioning ---------------------------------------------
# Base URL desk phones fetch their config from (usually the public proxy).
# Point each phone's provisioning server at <PROVISION_BASE_URL>/api/provision/.
PROVISION_BASE_URL=https://pbx.example.com
