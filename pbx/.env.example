# ============================================================================
#  OpenPBX — environment configuration
#  Copy to .env and fill in real values. NEVER commit your .env file.
# ============================================================================

# ---- General -------------------------------------------------------------
# Public hostname/IP clients and Twilio will reach this server on.
# Must be a publicly resolvable FQDN if you want TLS/WSS to work.
PUBLIC_HOSTNAME=pbx.example.com
# Public IP of this host (used in PJSIP external_media_address / NAT).
PUBLIC_IP=203.0.113.10
# Private/Docker network the media engine binds to (usually leave as-is).
LOCAL_NET=172.20.0.0/16

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=openpbx
POSTGRES_USER=openpbx
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Asterisk ARI / AMI --------------------------------------------------
# ARI is used by the management API for live call control & origination.
ARI_USERNAME=openpbx-ari
ARI_PASSWORD=change-me-ari-secret
# AMI is used for realtime events (registrations, CDR, queue stats).
AMI_USERNAME=openpbx-ami
AMI_PASSWORD=change-me-ami-secret

# ---- Management API ------------------------------------------------------
# 32+ char random string for signing JWTs.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First super-admin bootstrapped on startup if no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
ACCESS_TOKEN_TTL_MINUTES=720

# ---- RTP media port range (must match firewall / Twilio docs) ------------
RTP_START=10000
RTP_END=10200

# ---- SIP / WebRTC transports --------------------------------------------
SIP_UDP_PORT=5060
SIP_TCP_PORT=5060
SIP_TLS_PORT=5061
WSS_PORT=8089

# ---- TLS certificates (mount real certs in production) -------------------
# Paths INSIDE the asterisk container. The entrypoint generates a
# self-signed pair here on first boot if none are present.
TLS_CERT_FILE=/etc/asterisk/keys/fullchain.pem
TLS_KEY_FILE=/etc/asterisk/keys/privkey.pem
