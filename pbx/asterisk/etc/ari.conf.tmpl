; ============================================================================
;  ari.conf — REST + WebSocket control plane used by the management API for
;  click-to-call, live channel control and Stasis routing. Creds from .env.
; ============================================================================
[general]
enabled = yes
pretty = yes
allowed_origins = *

[${ARI_USERNAME}]
type = user
read_only = no
password = ${ARI_PASSWORD}
