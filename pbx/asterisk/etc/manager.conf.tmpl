; ============================================================================
;  manager.conf — AMI, used by the API to stream live events (registrations,
;  queue stats, hangups) and issue originate/redirect. Creds from .env.
;  AMI is bound to the internal docker network only — never expose 5038.
; ============================================================================
[general]
enabled = yes
port = 5038
bindaddr = 0.0.0.0
displayconnects = no
timestampevents = yes

[${AMI_USERNAME}]
secret = ${AMI_PASSWORD}
; restrict to the docker subnet
permit = 172.20.0.0/16
deny = 0.0.0.0/0.0.0.0
read = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan
write = system,call,agent,user,config,command,reporting,originate
